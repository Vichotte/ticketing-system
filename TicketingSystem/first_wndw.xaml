<Window x:Class="TicketingSystem.first_wndw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal"
        Height="450"
        Width="800"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFB0B0B0"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
                Height="50"
                VerticalAlignment="Top"
                CornerRadius="0,0,15,15"
                Padding="15,0">

            <DockPanel LastChildFill="False">

                <!-- Título izquierda -->
                <TextBlock Text="🎟️ Sistema de Tickets"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFE63946"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <!-- Panel derecha (usuario + salir) -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <!-- Display Name -->
                    <TextBlock x:Name="txtDisplayName"
                               Text="Usuario"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF5C5C5C"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <!-- Logout -->
                    <Border CornerRadius="20"
                            Background="#FFE63946"
                            VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                                Content="Exit"
                                Width="70"
                                Height="30"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="16"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>


        <!-- ===================== CONTENEDOR CENTRAL ===================== -->
        <Grid Margin="20,80,20,20">
            <Border CornerRadius="20" Background="#FFF9C74F" Padding="20">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock Text="Selecciona una opción"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFEA2E2E"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Botón Crear Ticket -->
                    <Button x:Name="btnCrearTicket"
                            Content="Crear Ticket"
                            Width="250"
                            Height="45"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="18"
                            BorderThickness="0"
                            Background="#FFFC7A00"
                            Cursor="Hand"
                            Margin="0,0,0,15"/>

                    <!-- Botón Mis Tickets -->
                    <Button x:Name="btnMisTickets"
                            Content="Mis Tickets"
                            Width="250"
                            Height="45"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="18"
                            BorderThickness="0"
                            Background="#FF4CAF50"
                            Cursor="Hand"
                            Margin="0,0,0,15"/>

                    <!-- Botón Todos los Tickets (deshabilitado visualmente) -->
                    <Button x:Name="btnTodosTickets"
                            Content="Todos los Tickets"
                            Width="250"
                            Height="45"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="18"
                            BorderThickness="0"
                            Background="#FF2196F3"
                            Cursor="Hand"
                            IsEnabled="False"
                            Margin="0,0,0,15"/>

                    <!-- Botón Gestión de Usuarios -->
                    <Button x:Name="btnGestionUsuarios"
                    Content="Gestión de Usuarios"
                    Width="250"
                    Height="45"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="18"
                    BorderThickness="0"
                    Background="#FF9C27B0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Margin="0,0,0,15"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>

