<Window x:Class="TicketingSystem.first_wndw"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal"
        Height="450"
        Width="800"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
        Height="50"
        VerticalAlignment="Top"
        CornerRadius="0,0,15,15"
        Padding="15,0">

            <DockPanel LastChildFill="False">

                <!-- Título izquierda -->
                <TextBlock Text="🎟️ Sistema de Tickets"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FFE63946"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"/>

                <!-- Panel derecha (usuario + salir) -->
                <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">

                    <!-- Display Name -->
                    <TextBlock x:Name="txtDisplayName"
                       Text="Usuario"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF5C5C5C"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

                    <!-- Logout -->
                    <Border CornerRadius="20"
                    Background="#FFE63946"
                    VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                        Content="Salir"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="Bold"
                        Width="70"
                        Height="30"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>


        <!-- ===================== CONTENEDOR CENTRAL (IGUAL AL LOGIN) ===================== -->
        <Grid Margin="20,80,20,20">
            <Border CornerRadius="20" Background="#FFF9C74F" Padding="20">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock Text="Selecciona una opción"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFEA2E2E"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Botón Crear Ticket -->
                    <Border CornerRadius="20" Background="#FFFC7A00" Margin="0,0,0,15">
                        <Button x:Name="btnCrearTicket"
                                Content="Crear Ticket"
                                Width="250"
                                Height="45"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="18"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"/>
                    </Border>

                    <!-- Botón Mis Tickets -->
                    <Border CornerRadius="20" Background="#FF4CAF50" Margin="0,0,0,15">
                        <Button x:Name="btnMisTickets"
                                Content="Mis Tickets"
                                Width="250"
                                Height="45"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="18"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"/>
                    </Border>

                    <!-- Botón Todos los Tickets -->
                    <Border CornerRadius="20" Background="#FF2196F3" Margin="0,0,0,15">
                        <Button x:Name="btnTodosTickets"
                                Content="Todos los Tickets"
                                Width="250"
                                Height="45"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="18"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                IsEnabled="False"/>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
