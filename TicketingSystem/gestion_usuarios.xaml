<Window x:Class="TicketingSystem.gestion_usuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios"
        Height="600"
        Width="1000"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 🎨 Estilo global para TODOS los botones -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- 🌈 HOVER SUAVE -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="border" Property="Background"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"/>
                            </Trigger>

                            <!-- 🚫 DESHABILITADO -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFB0B0B0"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
                Height="50"
                VerticalAlignment="Top"
                CornerRadius="0,0,15,15"
                Padding="15,0">
            <DockPanel LastChildFill="False">

                <!-- BOTÓN VOLVER ATRÁS -->
                <Button x:Name="btnBack"
                        Content="⟵"
                        Width="40"
                        Height="40"
                        FontSize="22"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="#E63946"
                        DockPanel.Dock="Left"
                        Margin="0,0,10,0"/>

                <!-- TÍTULO -->
                <TextBlock Text="🎟️ Gestión de Usuarios"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E63946"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <!-- DERECHA: USUARIO + EXIT -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock x:Name="txtDisplayName"
                               Text="Usuario"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#5C5C5C"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Border CornerRadius="20"
                            Background="#E63946"
                            VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                                Content="Exit"
                                Width="70"
                                Height="30"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="16"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== CONTENIDO PRINCIPAL ===================== -->
        <Grid Margin="20,80,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 🧾 TABLA DE USUARIOS -->
            <Border Grid.Column="0"
                    CornerRadius="15"
                    Background="White"
                    BorderBrush="#E63946"
                    BorderThickness="2"
                    Padding="15"
                    Margin="0,0,20,0">
                <DataGrid x:Name="dgUsuarios"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          RowHeight="35"
                          FontSize="16"
                          AlternatingRowBackground="#FFFDEBD0"
                          Background="White"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding username}" Width="*"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding display_name}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding role_name}" Width="*"/>
                        <DataGridTextColumn Header="Último Login" Binding="{Binding last_login_at}" Width="*"/>
                        <DataGridTextColumn Header="Creado" Binding="{Binding created_at}" Width="*"/>
                        <DataGridTextColumn Header="Actualizado" Binding="{Binding updated_at}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 🧩 FORMULARIO LATERAL -->
            <Border Grid.Column="1"
                    CornerRadius="15"
                    Background="#FFF9C74F"
                    Padding="20">
                <StackPanel>

                    <TextBlock Text="Gestión de Usuario"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Usuario"
                               FontSize="14"
                               Margin="0,0,0,3"
                               Foreground="#5C5C5C"/>
                    <TextBox x:Name="txtUsername"
                             Margin="0,0,0,10"
                             Height="28"/>

                    <TextBlock Text="Nombre para mostrar"
                               FontSize="14"
                               Margin="0,0,0,3"
                               Foreground="#5C5C5C"/>
                    <TextBox x:Name="txtDisplayNameForm"
                             Margin="0,0,0,10"
                             Height="28"/>

                    <TextBlock Text="Rol"
                               FontSize="14"
                               Margin="0,0,0,3"
                               Foreground="#5C5C5C"/>
                    <ComboBox x:Name="cmbRole"
                              Margin="0,0,0,10"
                              Height="28">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="User"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <Button x:Name="btnCrearUsuario"
                                Content="Crear"
                                Width="100"
                                Height="35"
                                Background="#4CAF50"
                                Margin="0,0,10,0"/>
                        <Button x:Name="btnEditarUsuario"
                                Content="Editar"
                                Width="100"
                                Height="35"
                                Background="#2196F3"
                                Margin="0,0,10,0"/>
                        <Button x:Name="btnEliminarUsuario"
                                Content="Eliminar"
                                Width="100"
                                Height="35"
                                Background="#E63946"/>
                    </StackPanel>

                    <Button x:Name="btnVerUsuarios"
                            Content="Refrescar lista"
                            Width="160"
                            Height="32"
                            Background="#FF2196F3"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
