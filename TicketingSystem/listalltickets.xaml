<Window x:Class="TicketingSystem.listalltickets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todos los Tickets"
        Height="600"
        Width="1000"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
                Height="50"
                VerticalAlignment="Top"
                CornerRadius="0,0,15,15"
                Padding="15,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="🎟️ Sistema de Tickets"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#E63946"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock x:Name="txtDisplayName"
                               Text="Usuario"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#5C5C5C"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Border CornerRadius="20"
                            Background="#E63946"
                            VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                                Content="Salir"
                                Background="Transparent"
                                Foreground="White"
                                FontWeight="Bold"
                                Width="70"
                                Height="30"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== TABLERO KANBAN ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="20,80,20,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- ========== OPEN ========== -->
                <Grid Grid.Column="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🟢 Open"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <!-- LISTBOX -->
                        <ListBox x:Name="colOpen"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <!-- DROP ZONE -->
                        <Border x:Name="dropOpen"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== IN PROGRESS ========== -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🟡 In Progress"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colProgress"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropProgress"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== RESOLVED ========== -->
                <Grid Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🔵 Resolved"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colResolved"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropResolved"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== CLOSED ========== -->
                <Grid Grid.Column="3" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚫ Closed"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colClosed"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropClosed"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

            </Grid>
        </ScrollViewer>

    </Grid>
</Window>


