<Window x:Class="TicketingSystem.listalltickets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todos los Tickets"
        Height="600"
        Width="1000"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadow"
          Color="Black"
          BlurRadius="10"
          ShadowDepth="2"
          Opacity="0.25"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFB0B0B0"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
        Height="50"
        VerticalAlignment="Top"
        CornerRadius="0,0,15,15"
        Padding="15,0">
            <DockPanel LastChildFill="False">

                <!-- BOTÓN VOLVER ATRÁS -->
                <Button x:Name="btnBack"
                Content="⟵"
                Width="40"
                Height="40"
                FontSize="22"
                FontWeight="Bold"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Foreground="#E63946"
                DockPanel.Dock="Left"
                Margin="0,0,10,0"/>

                <!-- TÍTULO -->
                <TextBlock Text="🎟️ Sistema de Tickets"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#E63946"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left"/>

                <!-- DERECHA: USUARIO + LOGOUT -->
                <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">

                    <TextBlock x:Name="txtDisplayName"
                       Text="Usuario"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#5C5C5C"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>

                    <!-- Campana de notificaciones -->
                    <Button x:Name="btnNotificaciones"
                        Content="🔔"
                        Width="50"
                        Height="50"
                        FontSize="20"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center"/>

                    <Border CornerRadius="20"
                    Background="#E63946"
                    VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                        Content="Exit"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="Bold"
                        Width="70"
                        Height="30"
                        BorderThickness="0"
                        Cursor="Hand"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== TABLERO KANBAN ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="20,80,20,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- ========== OPEN ========== -->
                <Grid Grid.Column="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🟢 Open"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <!-- LISTBOX -->
                        <ListBox x:Name="colOpen"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- DROP ZONE -->
                        <Border x:Name="dropOpen"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== IN PROGRESS ========== -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🟡 In Progress"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colProgress"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropProgress"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== RESOLVED ========== -->
                <Grid Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🔵 Resolved"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colResolved"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropResolved"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>


                <!-- ========== CLOSED ========== -->
                <Grid Grid.Column="3" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚫ Closed"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <Grid Grid.Row="1">

                        <ListBox x:Name="colClosed"
                                 AllowDrop="True"
                                 Drop="Column_Drop"
                                 DragEnter="Column_DragEnter"
                                 DragOver="Column_DragOver"
                                 DragLeave="Column_DragLeave"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel AllowDrop="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                        </ListBox>

                        <Border x:Name="dropClosed"
                                Background="#55A5D6A7"
                                CornerRadius="10"
                                Margin="0"
                                Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Height="120"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
        <!-- PANEL DE NOTIFICACIONES -->
        <Border x:Name="notifPanel"
Background="White"
CornerRadius="15"
BorderBrush="#FFD0D0D0"
BorderThickness="1"
Padding="15"
Width="250"
Height="300"
HorizontalAlignment="Right"
VerticalAlignment="Top"
Margin="0,60,20,0"
Visibility="Collapsed"
Effect="{DynamicResource DropShadow}">
            <StackPanel>
                <TextBlock Text="Notificaciones"
       FontSize="18"
       FontWeight="Bold"
       Foreground="#FF5C5C5C"
       Margin="0,0,0,10"/>
                <TextBlock Text="(No hay notificaciones aún)"
       FontSize="14"
       Foreground="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


