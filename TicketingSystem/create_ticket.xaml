<Window x:Class="TicketingSystem.create_ticket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Ticket"
        Height="559"
        Width="900"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0,0,30,8">
        <Border Background="#FFFCC15E"
                CornerRadius="20"
                Margin="20,20,0,10"
                Padding="40">

            <Grid>

                <TextBlock Text="📝 Crear Nuevo Ticket"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FFE63946"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           VerticalAlignment="Top"/>

                <StackPanel Margin="0,60,0,0"
                            HorizontalAlignment="Center"
                            Width="500">

                    <!-- Título -->
                    <TextBlock Text="Título del ticket"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF5C5C5C"/>
                    <TextBox x:Name="txtTitulo"
                             Height="35"
                             FontSize="16"
                             Margin="0,5,0,20"
                             Background="White"
                             BorderBrush="#FFE63946"
                             BorderThickness="2"
                             Padding="5"/>

                    <!-- Descripción -->
                    <TextBlock Text="Descripción"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FF5C5C5C"/>
                    <TextBox x:Name="txtDescripcion"
                             Height="150"
                             FontSize="16"
                             Margin="0,5,0,30"
                             Background="White"
                             BorderBrush="#FFE63946"
                             BorderThickness="2"
                             Padding="5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button x:Name="btnCrear"
                                Content="Crear Ticket"
                                Width="150"
                                Height="45"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#FF4CAF50"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,20,0"/>

                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Width="150"
                                Height="45"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="#FFE63946"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>

