<Window x:Class="TicketingSystem.listmytickets"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mis Tickets"
        Height="600"
        Width="1000"
        Background="#FFFDEBD0"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ===================== TOP BAR ===================== -->
        <Border Background="#FFFCC15E"
         Height="50"
         VerticalAlignment="Top"
         CornerRadius="0,0,15,15"
         Padding="15,0">

            <DockPanel LastChildFill="False">

                <!-- BOTÓN VOLVER ATRÁS -->
                <Button x:Name="btnBack"
                Content="⟵"
                Width="40"
                Height="40"
                FontSize="22"
                FontWeight="Bold"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Foreground="#E63946"
                DockPanel.Dock="Left"
                Margin="0,0,10,0"/>

                <!-- Título izquierda -->
                <TextBlock Text="🎟️ Sistema de Tickets"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#FFE63946"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"/>

                <!-- Panel derecha (usuario + salir) -->
                <StackPanel Orientation="Horizontal"
                 DockPanel.Dock="Right"
                 VerticalAlignment="Center"
                 Margin="0,0,10,0">

                    <!-- Display Name -->
                    <TextBlock x:Name="txtDisplayName"
                    Text="Usuario"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#FF5C5C5C"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"/>

                    <!-- Logout -->
                    <Border CornerRadius="20"
                     Background="#FFE63946"
                     VerticalAlignment="Center">
                        <Button x:Name="btnLogout"
                     Content="Log Out"
                     Background="Transparent"
                     Foreground="White"
                     FontWeight="Bold"
                     Width="70"
                     Height="30"
                     BorderThickness="0"
                     Cursor="Hand"
                     VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== CONTENIDO PRINCIPAL ===================== -->
        <Grid Margin="20,80,20,20">

            <Border Background="#FFF9C74F"
                    CornerRadius="20"
                    Padding="40">

                <Grid>
                    <!-- Título -->
                    <TextBlock Text="🎟️ Mis Tickets"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#E63946"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               VerticalAlignment="Top"/>

                    <!-- Contenedor de tarjetas -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Margin="0,60,0,70">
                        <WrapPanel x:Name="wpTickets"
                                   Orientation="Horizontal"
                                   ItemWidth="260"
                                   ItemHeight="180"
                                   Margin="10"
                                   HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


