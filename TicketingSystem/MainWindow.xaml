<Window x:Class="TicketingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticketing System" Height="350" Width="525"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Iniciando aplicación..." VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="0,20"/>
            <TextBox x:Name="OutputTextBox" Height="200" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</Window>
