<Window x:Class="TicketingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ticketing System" Height="400" Width="600"
        Background="#FFFDEBD0"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Border CornerRadius="20" Background="#FFF9C74F" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎟️ Ticketing System"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#FFEA2E2E"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Ingresa tus credenciales para acceder"
                           FontSize="16"
                           Foreground="#FF5C5C5C"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border CornerRadius="10" BorderBrush="#FFEA2E2E" BorderThickness="2" Background="White" Margin="0,0,0,10">
                    <TextBox x:Name="user_text"
                         Width="300" Height="35"
                         FontSize="14"
                         Padding="5"
                         BorderThickness="0"
                         Background="Transparent"
                         materialDesign:HintAssist.Hint="Usuario"/>

                </Border>

                <Border CornerRadius="10" BorderBrush="#FFEA2E2E" BorderThickness="2" Background="White" Margin="0,0,0,20">
                    <PasswordBox x:Name="password_text"
                         Width="300" Height="35"
                         FontSize="14"
                         Padding="5"
                         BorderThickness="0"
                         Background="Transparent"
                         materialDesign:HintAssist.Hint="Contraseña"/>

                </Border>

                <Border CornerRadius="20" Background="#FFFC7A00">
                    <Button Content="Entrar"
                            Width="150" Height="40"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="16"
                            BorderThickness="0"
                            Background="Transparent"
                            Click="Button_Click"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
